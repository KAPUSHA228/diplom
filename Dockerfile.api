# === Stage 1: Builder (сборка зависимостей) ===
FROM python:3.11-slim AS builder

WORKDIR /app

# Устанавливаем только build-зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Копируем только requirements
COPY requirements.txt .

# Создаём wheel-пакеты (без установки)
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /wheels -r requirements.txt

# === Stage 2: Production ===
FROM python:3.11-slim

WORKDIR /app

# Устанавливаем runtime-зависимости (без gcc/g++)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Копируем wheels из builder
COPY --from=builder /wheels /wheels
COPY requirements.txt .

# Устанавливаем из wheels
RUN pip install --no-cache-dir --find-links /wheels -r requirements.txt && \
    rm -rf /wheels

# Копируем код
COPY . .

# Создаём директории
RUN mkdir -p models logs/drift_reports experiments analysis_data/synthetic analysis_data/monitoring

ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "api.gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
